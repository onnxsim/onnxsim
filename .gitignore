dmypy.json

# Pyre type checker
.pyre/

.idea/
*.onnx
*.onnx.data

# Committed test fixtures, which the blanket *.onnx rule above would
# otherwise drop silently -- scripts/convertmodel/test/step_*.onnx are step
# graphs emitted by the library's own builders and checked in on purpose
# (see make_step_graph_fixtures.py); regenerating them must not un-track
# them, and a fixture missing from a fresh checkout fails CI rather than the
# author's machine.
!scripts/convertmodel/test/*.onnx

# Same reasoning for the WASM knowledge-distillation demo's checked-in
# assets (see examples/llm_distillation/wasm_demo/generate_web_artifacts.py):
# index.html fetches these small, tiny-architecture files directly, with no
# build/generation step at request time, so they must not be silently
# dropped by the blanket *.onnx rule above.
!examples/llm_distillation/wasm_demo/assets/*.onnx

# Tiny (34KB) unsimplified nanochat export, committed so it can be dropped
# straight into the browser wasm UI's file picker -- see scripts/nanochat/README.md.
# The same file also lives under scripts/convertmodel/, served same-origin
# for the "Load nanochat demo model" button (nanochat_demo.mjs) on the
# deployed converter page.
!scripts/nanochat/nanochat_wasm_demo.onnx
!scripts/convertmodel/nanochat_wasm_demo.onnx

compile_commands.json
temp*.py
test*.py
# ...but the real test suites under tests/ and tools/onnx-finetune/tests/ are
# tracked.
!tests/test*.py
!tools/onnx-finetune/tests/test*.py

.setuptools-cmake-build/
onnxsim/version.py

# scripts/cross/ build trees (Windows wheel, s390x big-endian, native control)
.cross-build/
.cross-build-s390x/
.native-build-control/

# Rust
/rust/target/
rust/Cargo.lock
# Prebuilt ONNX Runtime extracted for the Rust coverage job (ONNXSIM_ORT_HOME)
/rust/prebuilt-ort/

# ONNX Runtime source fetched on demand by the Rust build (see build_wasm.sh)
/third_party/onnxruntime-*/
/third_party/v*.zip

# emscripten SDK cloned by build_wasm.sh helpers
/emsdk/

# Pyodide xbuildenv (target Python headers) fetched on demand for
# build_wasm_pyodide.sh, e.g. via `pyodide xbuildenv install`
/.pyodide-xbuildenv/

# protobuf built on demand by build_wasm.sh when protoc is missing
/protobuf/

# Node deps for the convertmodel inference test / browser page
node_modules/

# ...but the convertmodel inference test's fixture model IS tracked.
!/scripts/convertmodel/test/model.onnx

# Self-hosted Netron: built into the converter site by the deploy workflow
# (scripts/convertmodel/netron) from a clone of the fork (netron-src). Neither
# is committed — they are produced at deploy time.
/scripts/convertmodel/netron/
/netron-src/

# The curated model list is copied next to the page by the deploy workflow so
# the "Load from Hugging Face" dropdown can read it same-origin. The source of
# truth is scripts/regression/models.json; the copy is a build artifact.
/scripts/convertmodel/models.json

# npm/onnxsim's wasm module + JS executor are build artifacts staged by
# scripts/build_npm_package.sh (from the ORT-web build and
# scripts/convertmodel/ort_executor.mjs respectively), not checked into git.
/npm/onnxsim/onnxsim.cjs
/npm/onnxsim/onnxsim.wasm
/npm/onnxsim/ort_executor.mjs

# Claude Code local session/tooling state (e.g. background-agent worktree
# checkouts under .claude/worktrees/) -- never part of the repo itself.
/.claude/
scripts/axera/vm/share/
tiny-random-mistral/
