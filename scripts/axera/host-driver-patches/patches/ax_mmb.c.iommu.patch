-		if ((void *)(scatterlist->sg_list[i].virtaddr) != NULL)
+		if ((void *)(scatterlist->sg_list[i].virtaddr) != NULL) {
+			dma_unmap_single(dev, scatterlist->sg_list[i].phyaddr,
+					 PAGE_ALIGN(scatterlist->sg_list[i].size),
+					 DMA_BIDIRECTIONAL);
 			kfree((void *)(scatterlist->sg_list[i].virtaddr));
+		}
 	}
 }
 
