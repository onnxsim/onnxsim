+template <bool is_channels_last, bool is_fused>
+Status Conv<is_channels_last, is_fused>::ComputeInternal(ComputeContext& context) const {
+  // A fused residual (4th input, from ConvActivationFusion's Conv+Add rule): out = activation(conv + bias + residual).
+  const Tensor* residual = context.InputCount() > 3 ? context.Input<Tensor>(3) : nullptr;
+  if (residual == nullptr) {
+    return ComputeImpl(context, activation_, nullptr, nullptr);
+  }
+  Status st = ComputeImpl(context, activation_, residual, nullptr);
+  if (st.IsOK() || st.Code() != common::NOT_IMPLEMENTED || st.ErrorMessage() != "WEBGPU_CONV_RESIDUAL_UNSUPPORTED") {
+    return st;
+  }
+  // Generic path: run the convolution without the activation into a temporary, then add + activate in one pass.
+  Tensor tmp;
+  ORT_RETURN_IF_ERROR(ComputeImpl(context, Activation(), nullptr, &tmp));
+  auto* output = context.Output(0, tmp.Shape());
+  const int64_t size = tmp.Shape().Size();
+  const int components = (size % 4 == 0 && tmp.Shape()[tmp.Shape().NumDimensions() - 1] % 4 == 0) ? 4 : 1;
+  const auto reduced = ReduceShapeByComponents(tmp.Shape(), components);
+  ConvResidualAddProgram program(activation_);
+  const auto total = static_cast<uint32_t>(size / components);
+  program.CacheHint(activation_.ToString(), components)
+      .AddInput({&tmp, ProgramTensorMetadataDependency::TypeAndRank, reduced, components})
+      .AddInput({residual, ProgramTensorMetadataDependency::TypeAndRank, reduced, components})
+      .AddOutput({output, ProgramTensorMetadataDependency::TypeAndRank, reduced, components})
+      .SetDispatchGroupSize((total + WORKGROUP_SIZE - 1) / WORKGROUP_SIZE)
+      .AddUniformVariables({{total}});
+  return context.RunProgram(program);
+}
