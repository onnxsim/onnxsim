+// WebGPU only: Conv (NHWC internal domain, with bias) -> Add(residual) => Conv with the residual as a 4th input.
+class ConvAddNhwcSelector : public NodeSelector {
+ public:
+  std::optional<NodesToOptimizeIndices> Select(const GraphViewer& graph_viewer, const Node& node) const override {
+    if (node.GetExecutionProviderType() != kWebGpuExecutionProvider) return std::nullopt;
+    static const bool enabled = [] { const char* e = std::getenv("ORT_WEBGPU_CONV_ADD_FUSION"); return e == nullptr || e[0] != '0'; }();
+    if (!enabled) return std::nullopt;
+    if (node.InputDefs().size() != 3 || !node.InputDefs()[2]->Exists() ||
+        graph_utils::GetNodeAttribute(node, "activation") != nullptr) {
+      return std::nullopt;
+    }
+    const auto* add = GetLoneConsumerNode(graph_viewer, node);
+    if (add == nullptr || add->GetExecutionProviderType() != kWebGpuExecutionProvider ||
+        !graph_utils::IsSupportedOptypeVersionAndDomain(*add, "Add", {7, 13, 14}) || add->InputDefs().size() != 2) {
+      return std::nullopt;
+    }
+    const auto* conv_out = node.OutputDefs()[0];
+    const auto* z = add->InputDefs()[1 - node.OutputEdgesBegin()->GetDstArgIndex()];
+    const auto* sa = conv_out->Shape();
+    const auto* sz = z->Shape();
+    if (sa == nullptr || sz == nullptr || sa->dim_size() != 4 || sz->dim_size() != 4) return std::nullopt;
+    for (int i = 0; i < 4; i++) {
+      const auto& da = sa->dim(i);
+      const auto& dz = sz->dim(i);
+      const bool same_value = utils::HasDimValue(da) && utils::HasDimValue(dz) && da.dim_value() == dz.dim_value();
+      const bool same_param = utils::HasDimParam(da) && utils::HasDimParam(dz) && da.dim_param() == dz.dim_param();
+      if (!same_value && !same_param) return std::nullopt;
+    }
+    NodesToOptimizeIndicesBuilder builder{};
+    builder.target_node = node.Index();
+    builder.output_nodes.push_back(add->Index());
+    return builder.Build();
+  }
+};
 }  // namespace selectors
 #endif  // !defined(ORT_MINIMAL_BUILD)
 
