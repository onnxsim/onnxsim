+using onnxruntime::webgpu::Activation;
+using onnxruntime::webgpu::WinogradWeightCache;
+using onnxruntime::webgpu::RunConcatConv1x1;
+using onnxruntime::webgpu::GetFusedActivationAttr;
+
+// Produced by ConvActivationFusion's WebGPU rule: Concat(axis=-1) -> 1x1 Conv. Inputs: W [M, C, 1, 1], B [M], X0..Xn-1 (NHWC float).
+class NhwcConcatConv1x1 final : public WebGpuKernel {
+ public:
+  NhwcConcatConv1x1(const OpKernelInfo& info) : WebGpuKernel(info) {
+    ORT_ENFORCE(GetFusedActivationAttr(info, activation_).IsOK());
+  }
+
+  Status PrePackInternal(ComputeContextBase& context, const Tensor& tensor, int input_idx, AllocatorPtr alloc, bool& is_packed) override {
+    is_packed = false;
+    if (input_idx != 0 || tensor.Shape().NumDimensions() != 4) return Status::OK();
+    const InlinedVector<size_t> perm{2, 3, 1, 0};  // [M, C, 1, 1] -> [1, 1, C, M]
+    const auto& s = tensor.Shape();
+    TensorShape ts({s[2], s[3], s[1], s[0]});
+    hwio_ = std::make_unique<Tensor>(tensor.DataType(), ts, alloc);
+    ORT_RETURN_IF_ERROR(onnxruntime::webgpu::Transpose::DoTranspose(context, perm, tensor, *hwio_));
+    is_packed = true;
+    return Status::OK();
+  }
+
+  Status ComputeInternal(ComputeContext& context) const override {
+    ORT_ENFORCE(hwio_ != nullptr, "NhwcConcatConv1x1 needs a constant weight (prepacked).");
+    std::vector<const Tensor*> xs;
+    for (int i = 2; i < context.InputCount(); i++) xs.push_back(context.Input<Tensor>(i));
+    const auto* bias = context.Input<Tensor>(1);
+    TensorShapeVector os = xs[0]->Shape().AsShapeVector();
+    os.back() = hwio_->Shape()[3];
+    Tensor* y = context.Output(0, TensorShape(os));
+    return RunConcatConv1x1(context, activation_, xs, hwio_.get(), bias, y, &w_cache_);
+  }
+
+ private:
+  Activation activation_;
+  std::unique_ptr<Tensor> hwio_;
+  mutable WinogradWeightCache w_cache_;
+};
+
+ONNX_OPERATOR_KERNEL_EX(
+    NhwcConcatConv1x1,
+    kMSDomain,
+    1,
+    kWebGpuExecutionProvider,
+    (*KernelDefBuilder::Create())
+        .TypeConstraint("T", DataTypeImpl::GetTensorType<float>()),
+    NhwcConcatConv1x1);
+
+}  // namespace webgpu
+}  // namespace contrib
+}  // namespace onnxruntime
