+// WebGPU only (opt-in, ORT_WEBGPU_CONCAT_CONV=1): Concat(axis = last) -> 1x1 stride-1 Conv (NHWC internal domain, constant weight, with bias)
+// => com.microsoft::NhwcConcatConv1x1(W, B, X0..Xn-1), which never materialises the concat.
+class ConcatConvSelector : public NodeSelector {
+ public:
+  std::optional<NodesToOptimizeIndices> Select(const GraphViewer& graph_viewer, const Node& node) const override {
+    if (node.GetExecutionProviderType() != kWebGpuExecutionProvider) return std::nullopt;
+    static const bool enabled = [] { const char* e = std::getenv("ORT_WEBGPU_CONCAT_CONV"); return e != nullptr && e[0] == '1'; }();
+    if (!enabled) return std::nullopt;
+    const auto& defs = node.InputDefs();
+    if (defs.size() != 3 || !defs[2]->Exists() || graph_utils::GetNodeAttribute(node, "activation") != nullptr) return std::nullopt;
+    const auto* group = graph_utils::GetNodeAttribute(node, "group");
+    if (group != nullptr && group->i() != 1) return std::nullopt;
+    for (const char* a : {"strides", "dilations", "pads"}) {
+      const auto* attr = graph_utils::GetNodeAttribute(node, a);
+      if (attr != nullptr) {
+        const bool want_zero = std::string_view(a) == "pads";
+        for (int64_t v : attr->ints()) {
+          if (v != (want_zero ? 0 : 1)) return std::nullopt;
+        }
+      }
+    }
+    const auto* w = graph_viewer.GetConstantInitializer(defs[1]->Name());
+    if (w == nullptr || w->dims_size() != 4 || w->dims(2) != 1 || w->dims(3) != 1 || w->dims(0) % 4 != 0 ||
+        w->data_type() != ONNX_NAMESPACE::TensorProto_DataType_FLOAT) {
+      return std::nullopt;
+    }
+    const Node* concat = graph_viewer.GetProducerNode(defs[0]->Name());
+    if (concat == nullptr || concat->OpType() != "Concat" || concat->Domain() != kOnnxDomain ||
+        concat->GetExecutionProviderType() != kWebGpuExecutionProvider || concat->GetOutputEdgesCount() != 1 ||
+        graph_viewer.NodeProducesGraphOutput(*concat)) {
+      return std::nullopt;
+    }
+    const auto* axis = graph_utils::GetNodeAttribute(*concat, "axis");
+    if (axis == nullptr || (axis->i() != 3 && axis->i() != -1)) return std::nullopt;
+    const size_t n = concat->InputDefs().size();
+    if (n < 2 || n > 6) return std::nullopt;
+    int64_t total = 0;
+    for (const auto* in : concat->InputDefs()) {
+      const auto* shape = in->Shape();
+      if (shape == nullptr || shape->dim_size() != 4 || !utils::HasDimValue(shape->dim(3)) || shape->dim(3).dim_value() % 4 != 0 ||
+          !HasElementDataType(*in, ONNX_NAMESPACE::TensorProto_DataType_FLOAT)) {
+        return std::nullopt;
+      }
+      total += shape->dim(3).dim_value();
+    }
+    if (total != w->dims(1) || total > 8192) return std::nullopt;
+    NodesToOptimizeIndicesBuilder builder{};
+    builder.target_node = node.Index();
+    builder.input_nodes.push_back(concat->Index());
+    return builder.Build();
+  }
+};
