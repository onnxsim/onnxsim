+
+// 1x1 stride-1 conv over the channel-concat of several NHWC vec4 inputs (the concat is never materialised); weights in an RGBA16F/RGBA32F texture.
+class ConvConcatTexProgram final : public Program<ConvConcatTexProgram> {
+ public:
+  ConvConcatTexProgram(const Activation& activation, bool has_bias, uint32_t n_inputs, uint32_t tm, uint32_t nv)
+      : Program("ConvConcatTex"), activation_(activation), has_bias_(has_bias), n_inputs_(n_inputs), tm_(tm), nv_(nv) {}
+  Status GenerateShaderCode(ShaderHelper& sh) const override;
+  WEBGPU_PROGRAM_DEFINE_UNIFORM_VARIABLES(
+      {"npix", ProgramUniformVariableDataType::Uint32},
+      {"co4", ProgramUniformVariableDataType::Uint32},
+      {"c4s", ProgramUniformVariableDataType::Uint32},
+      {"rows0", ProgramUniformVariableDataType::Uint32},
+      {"logical_dispatch_x", ProgramUniformVariableDataType::Uint32},
+      {"logical_dispatch_y", ProgramUniformVariableDataType::Uint32},
+      {"logical_dispatch_z", ProgramUniformVariableDataType::Uint32});
+
+ private:
+  const Activation& activation_;
+  bool has_bias_;
+  uint32_t n_inputs_, tm_, nv_;
+};
+
+// inputs: NHWC float tensors whose channel counts are multiples of 4; hwio: [1,1,sum(C),Cout] weights (buffer). Creates/reuses the weight texture in `w_cache`.
+Status RunConcatConv1x1(ComputeContext& context, const Activation& activation, const std::vector<const Tensor*>& inputs, const Tensor* hwio, const Tensor* bias,
+                        Tensor* output, WinogradWeightCache* w_cache);
