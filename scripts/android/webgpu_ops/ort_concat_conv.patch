+Status ConvConcatTexProgram::GenerateShaderCode(ShaderHelper& shader) const {
+  std::vector<const ShaderVariableHelper*> xs;
+  for (uint32_t i = 0; i < n_inputs_; i++) xs.push_back(&shader.AddInput("x" + std::to_string(i), ShaderUsage::UseUniform));
+  const ShaderVariableHelper* bias = has_bias_ ? &shader.AddInput("bias", ShaderUsage::UseUniform) : nullptr;
+  const auto& y = shader.AddOutput("y", ShaderUsage::UseUniform);
+  const int tex_binding = static_cast<int>(n_inputs_) + (has_bias_ ? 1 : 0) + 1 + 1;
+  shader.AdditionalImplementation() << "@group(0) @binding(" << tex_binding << ") var wtex : texture_2d<f32>;\n";
+  auto& b = shader.MainFunctionBody();
+  b << "  let logical_workgroup_id_z = workgroup_idx / (uniforms.logical_dispatch_x * uniforms.logical_dispatch_y);\n"
+    << "  let logical_workgroup_id_y = (workgroup_idx % (uniforms.logical_dispatch_x * uniforms.logical_dispatch_y)) / uniforms.logical_dispatch_x;\n"
+    << "  let logical_workgroup_id_x = (workgroup_idx % (uniforms.logical_dispatch_x * uniforms.logical_dispatch_y)) % uniforms.logical_dispatch_x;\n"
+    << "  let logical_workgroup_id = vec3u(logical_workgroup_id_x, logical_workgroup_id_y, logical_workgroup_id_z);\n"
+    << "  const workgroupSize = vec3u(workgroup_size_x, workgroup_size_y, workgroup_size_z);\n"
+    << "  let logical_global_id = logical_workgroup_id * workgroupSize + local_id;\n"
+    << "  let col0 = logical_global_id.y * " << nv_ << "u;\n  let p0 = logical_global_id.x * " << tm_ << "u;\n";
+  for (uint32_t m = 0; m < tm_; m++)
+    b << "  let pv" << m << " = p0 + " << m << "u < uniforms.npix;\n  let pp" << m << " = min(p0 + " << m << "u, uniforms.npix - 1u);\n";
+  for (uint32_t m = 0; m < tm_; m++)
+    for (uint32_t j = 0; j < 4 * nv_; j++) b << "  var c" << m << "_" << j << " = 0.0;\n";
+  b << "  if (col0 < uniforms.co4) {\n";
+  for (uint32_t i = 0; i < n_inputs_; i++) {
+    const std::string c4i = GetElementAt("uniforms.c4s", std::to_string(i), static_cast<int>(n_inputs_));
+    // rows of this input in the weight texture start at the sum of the previous inputs' channels
+    std::string rowstart = "0u";
+    for (uint32_t k = 0; k < i; k++) rowstart += " + 4u * " + GetElementAt("uniforms.c4s", std::to_string(k), static_cast<int>(n_inputs_));
+    b << "    for (var ci = 0u; ci < " << c4i << "; ci++) {\n";
+    for (uint32_t m = 0; m < tm_; m++) b << "      let a" << m << " = " << xs[i]->GetByOffset("pp" + std::to_string(m) + " * " + c4i + " + ci") << ";\n";
+    for (int kk = 0; kk < 4; kk++) {
+      for (uint32_t n = 0; n < nv_; n++)
+        b << "      let w" << kk << "_" << n << " = textureLoad(wtex, vec2<i32>(i32(min(col0 + " << n << "u, uniforms.co4 - 1u)), i32(" << rowstart << " + ci * 4u + " << kk << "u)), 0);\n";
+      for (uint32_t m = 0; m < tm_; m++)
+        for (uint32_t n = 0; n < nv_; n++)
+          for (int j = 0; j < 4; j++)
+            b << "      c" << m << "_" << n * 4 + j << " = fma(a" << m << "[" << kk << "], w" << kk << "_" << n << "[" << j << "], c" << m << "_" << n * 4 + j << ");\n";
+    }
+    b << "    }\n";
+  }
+  b << "  }\n";
+  const std::string act = GetActivationSnippet(activation_, "vec4<f32>", "f32");
+  for (uint32_t m = 0; m < tm_; m++)
+    for (uint32_t n = 0; n < nv_; n++) {
+      b << "  if (pv" << m << " && col0 + " << n << "u < uniforms.co4) {\n    var value = vec4<f32>(c" << m << "_" << n * 4 << ", c" << m << "_" << n * 4 + 1 << ", c" << m << "_" << n * 4 + 2 << ", c" << m << "_" << n * 4 + 3 << ");\n";
+      if (bias) b << "    value = value + " << bias->GetByOffset("col0 + " + std::to_string(n) + "u") << ";\n";
+      b << "    " << act << "\n    " << y.SetByOffset("pp" + std::to_string(m) + " * uniforms.co4 + col0 + " + std::to_string(n) + "u", "value") << "\n  }\n";
+    }
+  return Status::OK();
+}
+
+Status RunConcatConv1x1(ComputeContext& context, const Activation& activation, const std::vector<const Tensor*>& inputs, const Tensor* hwio, const Tensor* bias,
+                        Tensor* output, WinogradWeightCache* w_cache) {
+  static const auto env = [](const char* n, uint32_t d) { const char* e = std::getenv(n); return e ? static_cast<uint32_t>(std::atoi(e)) : d; };
+  static const uint32_t tm_def = env("ORT_WEBGPU_CONCATCONV_TM", 2), nv_def = env("ORT_WEBGPU_CONCATCONV_NV", 2), wx_def = env("ORT_WEBGPU_CONCATCONV_WX", 32), wy_def = env("ORT_WEBGPU_CONCATCONV_WY", 2);
+  static const int64_t f32_min_k = env("ORT_WEBGPU_TEXDIRECT_F32_MINK", 1024);
+  const auto& hs = hwio->Shape();  // [1,1,K,Cout]
+  const int64_t rows = hs[2], cout = hs[3];
+  uint32_t tm = tm_def, nv = nv_def, wx = wx_def, wy = wy_def;
+  {
+    // optional per-shape table ORT_WEBGPU_CONCATCONV_TABLE="cin:cout:ow=tm,nv,wx,wy;..." (pixels always along x)
+    static const std::string table = [] { const char* e = std::getenv("ORT_WEBGPU_CONCATCONV_TABLE"); return std::string(e ? e : ""); }();
+    if (!table.empty()) {
+      const std::string key = std::to_string(rows) + ":" + std::to_string(cout) + ":" + std::to_string(output->Shape()[2]);
+      size_t pos = 0;
+      while (pos < table.size()) {
+        size_t end = table.find(';', pos);
+        if (end == std::string::npos) end = table.size();
+        const std::string ent = table.substr(pos, end - pos);
+        pos = end + 1;
+        const size_t eq = ent.find('=');
+        if (eq == std::string::npos || ent.substr(0, eq) != key) continue;
+        unsigned a, b2, c, d;
+        if (std::sscanf(ent.c_str() + eq + 1, "%u,%u,%u,%u", &a, &b2, &c, &d) == 4) {
+          tm = a;
+          nv = b2;
+          wx = c;
+          wy = d;
+        }
+        break;
+      }
+    }
+    if (std::getenv("ORT_WEBGPU_CONCATCONV_LOG") != nullptr) {
+      std::fprintf(stderr, "CONCATCONV %lld:%lld:%lld\n", static_cast<long long>(rows), static_cast<long long>(cout), static_cast<long long>(output->Shape()[2]));
+    }
+  }
+  const uint32_t co4 = static_cast<uint32_t>(cout / 4);
+  const auto& os = output->Shape();
+  const uint32_t npix = static_cast<uint32_t>(os.Size() / cout);
+  const bool f32w = rows >= f32_min_k;
+  const wgpu::TextureFormat wfmt = f32w ? wgpu::TextureFormat::RGBA32Float : wgpu::TextureFormat::RGBA16Float;
+  auto ceil_div = [](uint32_t a, uint32_t b) { return (a + b - 1) / b; };
+  const auto M = ProgramTensorMetadataDependency::TypeAndRank;
+  auto red = [](const TensorShape& s) {
+    TensorShapeVector d = s.AsShapeVector();
+    d.back() /= 4;
+    return TensorShape(d);
+  };
+  wgpu::Texture tex_local;
+  wgpu::TextureView view;
+  if (w_cache && w_cache->valid) {
+    view = w_cache->view;
+  } else {
+    wgpu::TextureDescriptor td{};
+    td.size = {co4, static_cast<uint32_t>(rows), 1};
+    td.format = wfmt;
+    td.usage = wgpu::TextureUsage::StorageBinding | wgpu::TextureUsage::TextureBinding;
+    tex_local = context.Device().CreateTexture(&td);
+    view = tex_local.CreateView();
+    ConvTexDirectProgram p0(0, activation, false, false, tm, nv, false, f32w);
+    Tensor dummy = context.CreateGPUTensor(hwio->DataType(), TensorShape({4}));
+    const uint32_t total = static_cast<uint32_t>(rows) * co4;
+    p0.AddInput({hwio, M, red(hs), 4}).AddOutput({&dummy, M, TensorShape({1}), 4})
+        .SetExtraTexture(view.Get(), static_cast<WGPUTextureFormat>(wfmt), true)
+        .CacheHint(f32w ? "w32" : "w").SetDispatchGroupSize(ceil_div(total, 64))
+        .AddUniformVariables({{total}, {0u}, {0u}, {static_cast<uint32_t>(rows / 4)}, {co4}, {0u}, {0u}, {0u}, {0u}, {0u}, {0u}, {0u}, {0u}, {0u}, {0u}, {1u}, {1u}, {1u}});
+    ORT_RETURN_IF_ERROR(context.RunProgram(p0));
+    if (w_cache) {
+      w_cache->tex = tex_local;
+      w_cache->view = view;
+      w_cache->valid = true;
+    }
+  }
+  std::vector<uint32_t> c4s;
+  for (const auto* x : inputs) c4s.push_back(static_cast<uint32_t>(x->Shape()[x->Shape().NumDimensions() - 1] / 4));
+  const uint32_t gx = ceil_div(npix, tm * wx), gy = ceil_div(ceil_div(co4, nv), wy);
+  ConvConcatTexProgram p(activation, bias != nullptr, static_cast<uint32_t>(inputs.size()), tm, nv);
+  for (const auto* x : inputs) p.AddInput({x, M, red(x->Shape()), 4});
+  if (bias) p.AddInput({bias, M, red(bias->Shape()), 4});
+  p.AddOutput({output, M, red(os), 4})
+      .SetExtraTexture(view.Get(), static_cast<WGPUTextureFormat>(wfmt), false)
+      .CacheHint(activation.ToString(), std::to_string(inputs.size()) + "," + std::to_string(tm) + "," + std::to_string(nv) + "," + std::to_string(wx) + "," + std::to_string(wy) + "," + std::to_string(f32w), bias != nullptr)
+      .SetDispatchGroupSize(gx, gy, 1)
+      .SetWorkgroupSize(wx, wy, 1)
+      .AddUniformVariables({{npix}, {co4}, gsl::span<const uint32_t>(c4s.data(), c4s.size()), {0u}, {gx}, {gy}, {1u}});
+  return context.RunProgram(p);
+}
