+    auto& b = shader.MainFunctionBody();
+    b << shader.GuardAgainstOutOfBoundsWorkgroupSizes("uniforms.total")
+      << "  let cq = global_idx % uniforms.c4;\n  let t = global_idx / uniforms.c4;\n"
+      << "  let bi = t / uniforms.tiles_per_img;\n  let tt = t % uniforms.tiles_per_img;\n"
+      << "  let ty = i32(tt / uniforms.tw);\n  let tx = i32(tt % uniforms.tw);\n";
+    for (int r = 0; r < 4; r++)
+      for (int c = 0; c < 4; c++)
+        b << "  var d" << r << c << " = vec4<f32>(0.0);\n  { let iy = 2 * ty + " << r << " - i32(uniforms.pad_h); let ix = 2 * tx + " << c << " - i32(uniforms.pad_w);\n"
+          << "    if (iy >= 0 && iy < i32(uniforms.h) && ix >= 0 && ix < i32(uniforms.w)) { d" << r << c << " = "
+          << x.GetByOffset("((bi * uniforms.h + u32(iy)) * uniforms.w + u32(ix)) * uniforms.c4 + cq") << "; } }\n";
+    for (int c = 0; c < 4; c++)
+      b << "  let s0" << c << " = d0" << c << " - d2" << c << "; let s1" << c << " = d1" << c << " + d2" << c << "; let s2" << c << " = d2" << c << " - d1" << c << "; let s3" << c << " = d1" << c << " - d3" << c << ";\n";
+    for (int r = 0; r < 4; r++) {
+      std::string q = S(r);
+      std::string vals[4] = {"s" + q + "0 - s" + q + "2", "s" + q + "1 + s" + q + "2", "s" + q + "2 - s" + q + "1", "s" + q + "1 - s" + q + "3"};
+      for (int c = 0; c < 4; c++) b << "  " << v.SetByOffset(S(r * 4 + c) + "u * uniforms.total + global_idx", vals[c]) << "\n";
+    }
+    return Status::OK();
+  }
+  if (stage_ == 2) {
+    const auto& a = shader.AddInput("a", ShaderUsage::UseUniform);
+    const auto& bb = shader.AddInput("b", ShaderUsage::UseUniform);
+    const auto& m = shader.AddOutput("m", ShaderUsage::UseUniform);
+    auto& b = shader.MainFunctionBody();
+    b << "  let logical_workgroup_id_z = workgroup_idx / (uniforms.logical_dispatch_x * uniforms.logical_dispatch_y);\n"
+      << "  let logical_workgroup_id_y = (workgroup_idx % (uniforms.logical_dispatch_x * uniforms.logical_dispatch_y)) / uniforms.logical_dispatch_x;\n"
+      << "  let logical_workgroup_id_x = (workgroup_idx % (uniforms.logical_dispatch_x * uniforms.logical_dispatch_y)) % uniforms.logical_dispatch_x;\n"
+      << "  let logical_workgroup_id = vec3u(logical_workgroup_id_x, logical_workgroup_id_y, logical_workgroup_id_z);\n"
+      << "  const workgroupSize = vec3u(workgroup_size_x, workgroup_size_y, workgroup_size_z);\n"
+      << "  let logical_global_id = logical_workgroup_id * workgroupSize + local_id;\n"
+      << "  let e = logical_global_id.z;\n  let cin = uniforms.c4 * 4u;\n"
+      << "  let row0 = logical_global_id.y * " << tm_ << "u;\n  let col0 = logical_global_id.x * " << nv_ << "u;\n";
+    for (uint32_t i = 0; i < tm_; i++) b << "  let ar" << i << " = min(row0 + " << i << "u, uniforms.ntiles - 1u);\n";
+    for (uint32_t i = 0; i < nv_; i++) b << "  let bc" << i << " = min(col0 + " << i << "u, uniforms.co4 - 1u);\n";
+    for (uint32_t i = 0; i < tm_; i++)
+      for (uint32_t j = 0; j < 4 * nv_; j++) b << "  var c" << i << "_" << j << " = 0.0;\n";
+    b << "  for (var k4 = 0u; k4 < uniforms.c4; k4++) {\n";
+    for (uint32_t i = 0; i < tm_; i++) b << "    let a" << i << " = " << a.GetByOffset("(e * uniforms.ntiles + ar" + std::to_string(i) + ") * uniforms.c4 + k4") << ";\n";
+    for (int kk = 0; kk < 4; kk++) {
+      for (uint32_t n = 0; n < nv_; n++) b << "    let b" << kk << "_" << n << " = " << bb.GetByOffset("(e * cin + k4 * 4u + " + S(kk) + "u) * uniforms.co4 + bc" + std::to_string(n)) << ";\n";
+      for (uint32_t i = 0; i < tm_; i++)
+        for (uint32_t n = 0; n < nv_; n++)
+          for (int j = 0; j < 4; j++)
+            b << "    c" << i << "_" << n * 4 + j << " = fma(a" << i << "[" << kk << "], b" << kk << "_" << n << "[" << j << "], c" << i << "_" << n * 4 + j << ");\n";
+    }
+    b << "  }\n";
+    for (uint32_t i = 0; i < tm_; i++)
+      for (uint32_t n = 0; n < nv_; n++)
+        b << "  if (row0 + " << i << "u < uniforms.ntiles && col0 + " << n << "u < uniforms.co4) { "
+          << m.SetByOffset("(e * uniforms.ntiles + row0 + " + std::to_string(i) + "u) * uniforms.co4 + col0 + " + std::to_string(n) + "u",
+                           "vec4<f32>(c" + std::to_string(i) + "_" + std::to_string(n * 4) + ", c" + std::to_string(i) + "_" + std::to_string(n * 4 + 1) + ", c" + std::to_string(i) + "_" + std::to_string(n * 4 + 2) + ", c" + std::to_string(i) + "_" + std::to_string(n * 4 + 3) + ")")
+          << " }\n";
+    return Status::OK();
+  }
+  // stage 3: output transform + bias + activation
+  const auto& m = shader.AddInput("m", ShaderUsage::UseUniform);
+  const ShaderVariableHelper* bias = has_bias_ ? &shader.AddInput("bias", ShaderUsage::UseUniform) : nullptr;
+  const auto& y = shader.AddOutput("y", ShaderUsage::UseUniform);
+  auto& b = shader.MainFunctionBody();
+  b << shader.GuardAgainstOutOfBoundsWorkgroupSizes("uniforms.total")
+    << "  let cq = global_idx % uniforms.co4;\n  let t = global_idx / uniforms.co4;\n"
+    << "  let bi = t / uniforms.tiles_per_img;\n  let tt = t % uniforms.tiles_per_img;\n"
+    << "  let ty = tt / uniforms.tw;\n  let tx = tt % uniforms.tw;\n";
+  for (int r = 0; r < 4; r++)
+    for (int c = 0; c < 4; c++) b << "  let m" << r << c << " = " << m.GetByOffset(S(r * 4 + c) + "u * uniforms.total + global_idx") << ";\n";
+  for (int c = 0; c < 4; c++)
+    b << "  let s0" << c << " = m0" << c << " + m1" << c << " + m2" << c << "; let s1" << c << " = m1" << c << " - m2" << c << " - m3" << c << ";\n";
+  if (bias) b << "  let bv = " << bias->GetByOffset("cq") << ";\n";
+  const std::string act = GetActivationSnippet(activation_, "vec4<f32>", "f32");
+  for (int r = 0; r < 2; r++) {
+    std::string q = S(r);
+    std::string ys[2] = {"s" + q + "0 + s" + q + "1 + s" + q + "2", "s" + q + "1 - s" + q + "2 - s" + q + "3"};
+    for (int c = 0; c < 2; c++) {
+      b << "  { let oy = ty * 2u + " << r << "u; let ox = tx * 2u + " << c << "u; if (oy < uniforms.oh && ox < uniforms.ow) {\n"
+        << "    var value = " << ys[c] << ";\n"
+        << (bias ? "    value = value + bv;\n" : "") << "    " << act << "\n    "
+        << y.SetByOffset("((bi * uniforms.oh + oy) * uniforms.ow + ox) * uniforms.co4 + cq", "value") << "\n  } }\n";
+    }
+  }
+  return Status::OK();
+}
+
+Status TryApplyWinogradConv(ComputeContext& context, const Activation& activation, const Tensor* input, const Tensor* kernel, const Tensor* bias, const std::vector<uint32_t>& pads, Tensor* output, bool& applied, std::unique_ptr<Tensor>* u_cache) {
+  applied = false;
+  static const bool use_f16 = std::getenv("ORT_WEBGPU_WINO_F16") && std::atoi(std::getenv("ORT_WEBGPU_WINO_F16")) != 0;
+  static const int mode = [] { const char* e = std::getenv("ORT_WEBGPU_CONV_WINOGRAD"); return e ? std::atoi(e) : 1; }();
+  if (mode == 0 || !input->IsDataType<float>()) return Status::OK();
+  const auto& ks = kernel->Shape();  // HWIO
+  const auto& is = input->Shape();
+  const auto& os = output->Shape();
+  if (ks.NumDimensions() != 4 || ks[0] != 3 || ks[1] != 3 || is.NumDimensions() != 4) return Status::OK();
+  const int64_t cin = ks[2], cout = ks[3];
+  if (cin % 4 != 0 || cout % 4 != 0 || cin != is[3] || os[3] != cout) return Status::OK();
+  static const auto env = [](const char* n, uint32_t d) { const char* e = std::getenv(n); return e ? static_cast<uint32_t>(std::atoi(e)) : d; };
+  static const uint32_t tm = env("ORT_WEBGPU_WINO_TM", 4), nv = env("ORT_WEBGPU_WINO_NV", 2), wx = env("ORT_WEBGPU_WINO_WX", 16), wy = env("ORT_WEBGPU_WINO_WY", 4);
+  static const int64_t min_hw = env("ORT_WEBGPU_WINO_MINHW", 0), max_hw = env("ORT_WEBGPU_WINO_MAXHW", 1 << 20);
+  static const int64_t min_c = env("ORT_WEBGPU_WINO_MINC", 64);
+  if (std::min(cin, cout) < min_c) return Status::OK();
+  if (os[1] < min_hw || os[1] > max_hw) return Status::OK();
+  const uint32_t n = static_cast<uint32_t>(is[0]), h = static_cast<uint32_t>(is[1]), w = static_cast<uint32_t>(is[2]);
+  const uint32_t oh = static_cast<uint32_t>(os[1]), ow = static_cast<uint32_t>(os[2]);
+  const uint32_t c4 = static_cast<uint32_t>(cin / 4), co4 = static_cast<uint32_t>(cout / 4);
+  const uint32_t th = (oh + 1) / 2, tw = (ow + 1) / 2, tpi = th * tw, nt = n * tpi;
+  const bool f16 = use_f16 && cin % 8 == 0 && cout % 8 == 0;
+  auto* dt = input->DataType();
+  auto* u32t = DataTypeImpl::GetType<uint32_t>();
+  const bool have_u = u_cache && *u_cache;
+  Tensor u_local;
+  if (!have_u) u_local = context.CreateGPUTensor(f16 ? u32t : dt, TensorShape({16, cin, f16 ? cout / 2 : cout}));
+  Tensor* up = have_u ? u_cache->get() : &u_local;
+  Tensor v = context.CreateGPUTensor(f16 ? u32t : dt, TensorShape({16, static_cast<int64_t>(nt), f16 ? cin / 2 : cin}));
+  Tensor m = context.CreateGPUTensor(dt, TensorShape({16, static_cast<int64_t>(nt), cout}));
+  auto red = [](const TensorShape& s) {
+    TensorShapeVector d = s.AsShapeVector();
+    d.back() /= 4;
+    return TensorShape(d);
+  };
+#define WINO_UNIFORMS(total, dx, dy, dz) \
+  {{total}, {h}, {w}, {c4}, {co4}, {tw}, {nt}, {oh}, {ow}, {pads[0]}, {pads[1]}, {tpi}, {dx}, {dy}, {dz}}
+  auto ceil_div = [](uint32_t a, uint32_t b) { return (a + b - 1) / b; };
+  const auto M = ProgramTensorMetadataDependency::TypeAndRank;
+  if (!have_u) {
+    ConvWinogradProgram p(0, activation, false, tm, nv, wx, wy, f16);
+    uint32_t total = f16 ? c4 * 4 * (co4 / 2) : c4 * 4 * co4;
+    p.AddInput({kernel, M, red(ks), 4}).AddOutput({up, M, red(up->Shape()), 4}).CacheHint(f16 ? "w16" : "w").SetDispatchGroupSize(ceil_div(total, 64)).AddUniformVariables(WINO_UNIFORMS(total, 1, 1, 1));
+    ORT_RETURN_IF_ERROR(context.RunProgram(p));
+    if (u_cache) { *u_cache = std::make_unique<Tensor>(std::move(u_local)); up = u_cache->get(); }
+  }
+  {
+    ConvWinogradProgram p(1, activation, false, tm, nv, wx, wy, f16);
+    uint32_t total = f16 ? nt * (c4 / 2) : nt * c4;
+    p.AddInput({input, M, red(is), 4}).AddOutput({&v, M, red(v.Shape()), 4}).CacheHint(f16 ? "i16" : "i").SetDispatchGroupSize(ceil_div(total, 64)).AddUniformVariables(WINO_UNIFORMS(total, 1, 1, 1));
+    ORT_RETURN_IF_ERROR(context.RunProgram(p));
+  }
+  {
+    ConvWinogradProgram p(2, activation, false, tm, nv, wx, wy, f16);
+    uint32_t gx = f16 ? ceil_div(co4 / 2, wx) : ceil_div(ceil_div(co4, nv), wx), gy = ceil_div(nt, tm * wy);
+    p.AddInput({&v, M, red(v.Shape()), 4}).AddInput({up, M, red(up->Shape()), 4}).AddOutput({&m, M, red(m.Shape()), 4})
+        .CacheHint(std::string(f16 ? "h" : "g") + std::to_string(tm) + "," + std::to_string(nv) + "," + std::to_string(wx) + "," + std::to_string(wy))
+        .SetDispatchGroupSize(gx, gy, 16).SetWorkgroupSize(wx, wy, 1).AddUniformVariables(WINO_UNIFORMS(0, gx, gy, 16));
+    ORT_RETURN_IF_ERROR(context.RunProgram(p));
+  }
+  {
+    ConvWinogradProgram p(3, activation, bias != nullptr, tm, nv, wx, wy);
+    uint32_t total = nt * co4;
+    p.AddInput({&m, M, red(m.Shape()), 4});
+    if (bias) p.AddInput({bias, M, red(bias->Shape()), 4});
+    p.AddOutput({output, M, red(os), 4}).CacheHint("o," + activation.ToString() + std::to_string(bias != nullptr)).SetDispatchGroupSize(ceil_div(total, 64)).AddUniformVariables(WINO_UNIFORMS(total, 1, 1, 1));
+    ORT_RETURN_IF_ERROR(context.RunProgram(p));
+  }
+  applied = true;
+  return Status::OK();
+}
