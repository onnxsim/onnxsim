+// Winograd F(2,3) for 3x3 stride-1 NHWC fp32 convs: weight transform, input transform, 16 batched GEMMs, output transform (+bias, activation).
+class ConvWinogradProgram final : public Program<ConvWinogradProgram> {
+ public:
+  ConvWinogradProgram(int stage, const Activation& activation, bool has_bias, uint32_t tm, uint32_t nv, uint32_t wx, uint32_t wy, bool f16 = false)
+      : Program("ConvWinograd"), stage_(stage), activation_(activation), has_bias_(has_bias), tm_(tm), nv_(nv), wx_(wx), wy_(wy), f16_(f16) {}
+  Status GenerateShaderCode(ShaderHelper& sh) const override;
+  WEBGPU_PROGRAM_DEFINE_UNIFORM_VARIABLES(
+      {"total", ProgramUniformVariableDataType::Uint32},
+      {"h", ProgramUniformVariableDataType::Uint32},
+      {"w", ProgramUniformVariableDataType::Uint32},
+      {"c4", ProgramUniformVariableDataType::Uint32},
+      {"co4", ProgramUniformVariableDataType::Uint32},
+      {"tw", ProgramUniformVariableDataType::Uint32},
+      {"ntiles", ProgramUniformVariableDataType::Uint32},
+      {"oh", ProgramUniformVariableDataType::Uint32},
+      {"ow", ProgramUniformVariableDataType::Uint32},
+      {"pad_h", ProgramUniformVariableDataType::Uint32},
+      {"pad_w", ProgramUniformVariableDataType::Uint32},
+      {"tiles_per_img", ProgramUniformVariableDataType::Uint32},
+      {"logical_dispatch_x", ProgramUniformVariableDataType::Uint32},
+      {"logical_dispatch_y", ProgramUniformVariableDataType::Uint32},
+      {"logical_dispatch_z", ProgramUniformVariableDataType::Uint32});
+
+ private:
+  int stage_;  // 0 weight transform, 1 input transform, 2 batched GEMM, 3 output transform
+  const Activation& activation_;
+  bool has_bias_;
+  uint32_t tm_, nv_, wx_, wy_;
+  bool f16_;  // V and U stored as packed f16 (uint32 tensors), GEMM accumulates in f32
+};
+
+// Returns true (and runs the four programs) when the conv qualifies; `kernel` is HWIO [3,3,Cin,Cout].
+Status TryApplyWinogradConv(ComputeContext& context, const Activation& activation, const Tensor* input, const Tensor* kernel, const Tensor* bias, const std::vector<uint32_t>& pads, Tensor* output, bool& applied, std::unique_ptr<Tensor>* u_cache = nullptr);
