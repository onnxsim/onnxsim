@@ -118,5 +118,46 @@ class ConvWinogradProgram final : public Program<ConvWinogradProgram> {
 // Returns true (and runs the four programs) when the conv qualifies; `kernel` is HWIO [3,3,Cin,Cout].
 Status TryApplyWinogradConv(ComputeContext& context, const Activation& activation, const Tensor* input, const Tensor* kernel, const Tensor* bias, const std::vector<uint32_t>& pads, Tensor* output, bool& applied, WinogradWeightCache* u_cache = nullptr, const Tensor* residual = nullptr);
 
+
+// Direct (non-Winograd) NHWC vec4 convolution with the weights in an RGBA16F texture (read with textureLoad): register-tiled,
+// TM output pixels x NV vec4 output channels per thread, f32 math. Stage 0 uploads the HWIO weights into the texture.
+class ConvTexDirectProgram final : public Program<ConvTexDirectProgram> {
+ public:
+  ConvTexDirectProgram(int stage, const Activation& activation, bool has_bias, bool has_residual, uint32_t tm, uint32_t nv, bool pixels_fast = false)
+      : Program("ConvTexDirect"), stage_(stage), activation_(activation), has_bias_(has_bias), has_residual_(has_residual), tm_(tm), nv_(nv), pixels_fast_(pixels_fast) {}
+  Status GenerateShaderCode(ShaderHelper& sh) const override;
+  WEBGPU_PROGRAM_DEFINE_UNIFORM_VARIABLES(
+      {"npix", ProgramUniformVariableDataType::Uint32},
+      {"h", ProgramUniformVariableDataType::Uint32},
+      {"w", ProgramUniformVariableDataType::Uint32},
+      {"c4", ProgramUniformVariableDataType::Uint32},
+      {"co4", ProgramUniformVariableDataType::Uint32},
+      {"oh", ProgramUniformVariableDataType::Uint32},
+      {"ow", ProgramUniformVariableDataType::Uint32},
+      {"kh", ProgramUniformVariableDataType::Uint32},
+      {"kw", ProgramUniformVariableDataType::Uint32},
+      {"sh", ProgramUniformVariableDataType::Uint32},
+      {"sw", ProgramUniformVariableDataType::Uint32},
+      {"ph", ProgramUniformVariableDataType::Uint32},
+      {"pw", ProgramUniformVariableDataType::Uint32},
+      {"dh", ProgramUniformVariableDataType::Uint32},
+      {"dw", ProgramUniformVariableDataType::Uint32},
+      {"logical_dispatch_x", ProgramUniformVariableDataType::Uint32},
+      {"logical_dispatch_y", ProgramUniformVariableDataType::Uint32},
+      {"logical_dispatch_z", ProgramUniformVariableDataType::Uint32});
+
+ private:
+  int stage_;  // 0: weights buffer -> RGBA16F texture, 1: convolution
+  const Activation& activation_;
+  bool has_bias_, has_residual_;
+  uint32_t tm_, nv_;
+  bool pixels_fast_;  // threads along x cover output pixels (activation loads coalesce), along y output channels
+};
+
+// Runs the texture-weight direct conv when it applies (float32, group 1, NHWC, Cin and Cout multiples of 4, weight rows <= 8192).
+Status TryApplyTexDirectConv(ComputeContext& context, const Activation& activation, const Tensor* input, const Tensor* kernel, const Tensor* bias,
+                             const std::vector<uint32_t>& pads, const std::vector<uint32_t>& strides, const std::vector<uint32_t>& dilations,
+                             Tensor* output, bool& applied, WinogradWeightCache* w_cache, const Tensor* residual, bool one_by_one_ok);
+
 }  // namespace webgpu
 }  // namespace onnxruntime
