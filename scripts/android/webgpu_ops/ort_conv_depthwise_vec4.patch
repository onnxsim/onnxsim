+// Depthwise (group == Cin == Cout) NHWC convolution with vec4 channels: each thread produces P consecutive output pixels of one vec4 of channels.
+class ConvDepthwiseVec4Program final : public Program<ConvDepthwiseVec4Program> {
+ public:
+  ConvDepthwiseVec4Program(const Activation& activation, bool has_bias, uint32_t pixels)
+      : Program("ConvDepthwiseVec4"), activation_(activation), has_bias_(has_bias), pixels_(pixels) {}
+  Status GenerateShaderCode(ShaderHelper& sh) const override;
+  WEBGPU_PROGRAM_DEFINE_UNIFORM_VARIABLES(
+      {"total", ProgramUniformVariableDataType::Uint32},
+      {"h", ProgramUniformVariableDataType::Uint32},
+      {"w", ProgramUniformVariableDataType::Uint32},
+      {"c4", ProgramUniformVariableDataType::Uint32},
+      {"oh", ProgramUniformVariableDataType::Uint32},
+      {"ow", ProgramUniformVariableDataType::Uint32},
+      {"kh", ProgramUniformVariableDataType::Uint32},
+      {"kw", ProgramUniformVariableDataType::Uint32},
+      {"sh", ProgramUniformVariableDataType::Uint32},
+      {"sw", ProgramUniformVariableDataType::Uint32},
+      {"ph", ProgramUniformVariableDataType::Uint32},
+      {"pw", ProgramUniformVariableDataType::Uint32},
+      {"dh", ProgramUniformVariableDataType::Uint32},
+      {"dw", ProgramUniformVariableDataType::Uint32},
+      {"nxg", ProgramUniformVariableDataType::Uint32});
+
+ private:
+  const Activation& activation_;
+  bool has_bias_;
+  uint32_t pixels_;
+};
