+Status ConvDepthwiseVec4Program::GenerateShaderCode(ShaderHelper& shader) const {
+  const auto& x = shader.AddInput("x", ShaderUsage::UseUniform);
+  const auto& w = shader.AddInput("w", ShaderUsage::UseUniform);
+  const ShaderVariableHelper* bias = has_bias_ ? &shader.AddInput("bias", ShaderUsage::UseUniform) : nullptr;
+  const auto& y = shader.AddOutput("y", ShaderUsage::UseUniform);
+  auto& b = shader.MainFunctionBody();
+  b << shader.GuardAgainstOutOfBoundsWorkgroupSizes("uniforms.total")
+    << "  let c4i = global_idx % uniforms.c4;\n  var t = global_idx / uniforms.c4;\n"
+    << "  let oxg = t % uniforms.nxg;\n  t = t / uniforms.nxg;\n  let oy = t % uniforms.oh;\n  let bi = t / uniforms.oh;\n"
+    << "  let ox0 = oxg * " << pixels_ << "u;\n";
+  for (uint32_t p = 0; p < pixels_; p++) b << "  var a" << p << " = vec4<f32>(0.0);\n";
+  b << "  for (var ky = 0u; ky < uniforms.kh; ky++) {\n"
+    << "    let iy = i32(oy * uniforms.sh) - i32(uniforms.ph) + i32(ky * uniforms.dh);\n"
+    << "    if (iy < 0 || iy >= i32(uniforms.h)) { continue; }\n"
+    << "    let rowbase = (bi * uniforms.h + u32(iy)) * uniforms.w;\n"
+    << "    for (var kx = 0u; kx < uniforms.kw; kx++) {\n"
+    << "      let wv = " << w.GetByOffset("(ky * uniforms.kw + kx) * uniforms.c4 + c4i") << ";\n";
+  for (uint32_t p = 0; p < pixels_; p++)
+    b << "      { let ix = i32((ox0 + " << p << "u) * uniforms.sw) - i32(uniforms.pw) + i32(kx * uniforms.dw);\n"
+      << "        if (ix >= 0 && ix < i32(uniforms.w)) { a" << p << " = a" << p << " + " << x.GetByOffset("(rowbase + u32(ix)) * uniforms.c4 + c4i") << " * wv; } }\n";
+  b << "    }\n  }\n";
+  const std::string act = GetActivationSnippet(activation_, "vec4<f32>", "f32");
+  for (uint32_t p = 0; p < pixels_; p++) {
+    b << "  if (ox0 + " << p << "u < uniforms.ow) {\n    var value = a" << p << ";\n";
+    if (bias) b << "    value = value + " << bias->GetByOffset("c4i") << ";\n";
+    b << "    " << act << "\n    " << y.SetByOffset("((bi * uniforms.oh + oy) * uniforms.ow + ox0 + " + std::to_string(p) + "u) * uniforms.c4 + c4i", "value") << "\n  }\n";
+  }
+  return Status::OK();
+}
+
+Status TryApplyDepthwiseConv(ComputeContext& context, const Activation& activation, const Tensor* input, const Tensor* kernel, const Tensor* bias,
+                             const std::vector<uint32_t>& pads, const std::vector<uint32_t>& strides, const std::vector<uint32_t>& dilations,
+                             Tensor* output, bool& applied) {
+  applied = false;
+  static const auto env = [](const char* n, uint32_t d) { const char* e = std::getenv(n); return e ? static_cast<uint32_t>(std::atoi(e)) : d; };
+  static const uint32_t pixels = env("ORT_WEBGPU_DEPTHWISE_PIXELS", 4);  // 0 disables
+  if (pixels == 0 || !input->IsDataType<float>()) return Status::OK();
+  const auto& ks = kernel->Shape();
+  const auto& is = input->Shape();
+  const auto& os = output->Shape();
+  if (ks.NumDimensions() != 4 || is.NumDimensions() != 4 || ks[2] != 1) return Status::OK();
+  const int64_t c = ks[3];
+  if (c % 4 != 0 || is[3] != c || os[3] != c) return Status::OK();
+  const uint32_t c4 = static_cast<uint32_t>(c / 4), ow = static_cast<uint32_t>(os[2]);
+  const uint32_t nxg = (ow + pixels - 1) / pixels;
+  const uint32_t total = static_cast<uint32_t>(os[0]) * static_cast<uint32_t>(os[1]) * nxg * c4;
+  auto red = [](const TensorShape& s) {
+    TensorShapeVector d = s.AsShapeVector();
+    d.back() /= 4;
+    return TensorShape(d);
+  };
+  const auto M = ProgramTensorMetadataDependency::TypeAndRank;
+  ConvDepthwiseVec4Program p(activation, bias != nullptr, pixels);
+  p.AddInput({input, M, red(is), 4}).AddInput({kernel, M, red(ks), 4});
+  if (bias) p.AddInput({bias, M, red(bias->Shape()), 4});
+  p.AddOutput({output, M, red(os), 4})
+      .CacheHint(activation.ToString(), pixels, bias != nullptr)
+      .SetDispatchGroupSize((total + 63) / 64)
+      .AddUniformVariables({{total}, {static_cast<uint32_t>(is[1])}, {static_cast<uint32_t>(is[2])}, {c4}, {static_cast<uint32_t>(os[1])}, {ow},
+                            {static_cast<uint32_t>(ks[0])}, {static_cast<uint32_t>(ks[1])}, {strides[0]}, {strides[1]}, {pads[0]}, {pads[1]}, {dilations[0]}, {dilations[1]}, {nxg}});
+  ORT_RETURN_IF_ERROR(context.RunProgram(p));
+  applied = true;
+  return Status::OK();
+}
