       } else if (activation_type == "HardSigmoid") {
         activation.activation_kind_ = ActivationKind::HardSigmoid;
         activation_params_count = 2;
+      } else if (activation_type == "Gelu") {
+        activation.activation_kind_ = ActivationKind::Gelu;
+        activation_params_count = 1;  // 0 = exact (erf), 1 = tanh approximation
       } else if (activation_type == "QuickGelu") {
         activation.activation_kind_ = ActivationKind::QuickGelu;
         activation_params_count = 1;
@@ -78,6 +81,14 @@ std::string GetActivationSnippet(const Activation& activation, std::string value
              " * value, value, value >= " + value_type_cast(0.0) + ");";
     case ActivationKind::Tanh:
       return "value = tanh(value);";
+    case ActivationKind::Gelu:
+      if (activation.activation_params_.Gelu.tanh_ != 0.0f) {
+        return "{ let gu = clamp(0.7978845608028654 * (value + 0.044715 * value * value * value), " + value_type_cast(-10.0) + ", " + value_type_cast(10.0) + "); value = 0.5 * value * (1.0 + tanh(gu)); }";
+      }
+      // 0.5 * x * (1 + erf(x / sqrt(2))) with the same Abramowitz-Stegun erf approximation as the Gelu/Erf kernels
+      return "{ let gav = abs(value * 0.7071067811865475); let gex = 1.0 / (1.0 + 0.3275911 * gav); "
+             "let ger = sign(value) * (1.0 - ((((1.061405429 * gex - 1.453152027) * gex + 1.421413741) * gex - 0.284496736) * gex + 0.254829592) * gex * exp(-gav * gav)); "
+             "value = 0.5 * value * (1.0 + ger); }";
     case ActivationKind::QuickGelu:
       // x * sigmoid(alpha * x) = x / (1 + exp(-alpha * x)); exp overflows to +inf for very negative x, giving -0, which is right.
       return "value = value / (" + value_type_cast(1.0) + " + exp(-" + base_type_cast(activation.activation_params_.QuickGelu.alpha_) + " * value));";
