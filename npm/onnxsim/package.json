{
  "name": "onnxsim",
  "version": "0.7.3",
  "description": "Simplify ONNX models — WebAssembly build, with constant folding delegated to onnxruntime-web",
  "type": "module",
  "main": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "ort_executor.mjs",
    "onnxsim.cjs",
    "onnxsim.wasm",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/index.test.mjs",
    "prepublishOnly": "node -e \"if(!require('fs').existsSync('onnxsim.wasm')){console.error('onnxsim.wasm is missing -- run scripts/build_npm_package.sh first');process.exit(1)}\" && npm test"
  },
  "dependencies": {
    "onnxruntime-web": "^1.29.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onnxsim/onnxsim.git",
    "directory": "npm/onnxsim"
  },
  "homepage": "https://github.com/onnxsim/onnxsim#readme",
  "bugs": {
    "url": "https://github.com/onnxsim/onnxsim/issues"
  },
  "keywords": [
    "onnx",
    "onnxsim",
    "simplifier",
    "wasm",
    "webassembly",
    "onnxruntime-web",
    "machine-learning"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
